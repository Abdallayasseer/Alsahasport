{
  "info": {
    "_postman_id": "b3e3462a-8812-45e1-9533-305140683610",
    "name": "Alsaha System - Refactored",
    "description": "Fully updated collection for Refactored Backend Architecture. Includes strict security tests, auto-token capture, and organized folders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Activate Code (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "    console.log(\"Access Token updated successfully\");",
                  "}",
                  "// Refresh token is HttpOnly cookie, but if returned in body (optional), capture it:",
                  "if (jsonData.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
                  "}",
                  "pm.expect(pm.response.code).to.be.oneOf([200, 201]);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"RAW_CODE_FROM_DISPLAY_ENDPOINT\",\n    \"deviceId\": \"android_test_device_001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/activate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "activate"
              ]
            },
            "description": "\nRedeems an activation code and returns session tokens + Provider Credentials.\n\n**Response Example:**\n```json\n{\n  \"success\": true,\n  \"data\": {\n    \"token\": \"jwt...\",\n    \"subscription\": {\n      \"status\": \"Active\",\n      \"host_url\": \"http://provider.com\",\n      \"username\": \"UserCode\",\n      \"password\": \"UserCode\"\n    }\n  }\n}\n```\n        "
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "    console.log(\"Access Token Refreshed\");",
                  "}",
                  "pm.expect(pm.response.code).to.be.oneOf([200, 201]);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Send refresh token in body if cookies not automatically handled by client"
          },
          "response": []
        },
        {
          "name": "Validate Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/validate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "validate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Admin Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                      "    console.log(\"Admin Token updated successfully\");",
                      "}",
                      "pm.expect(pm.response.code).to.be.oneOf([200, 201]);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"{{password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/admin/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "admin",
                    "login"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Code Management",
          "item": [
            {
              "name": "Create Code",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                      "if (jsonData.data && jsonData.data.displayToken) {",
                      "    pm.collectionVariables.set(\"display_token\", jsonData.data.displayToken);",
                      "    pm.collectionVariables.set(\"code_id\", jsonData.data.id);",
                      "    console.log(\"Display Token Saved\");",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"durationDays\": 30\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/admin/codes",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "admin",
                    "codes"
                  ]
                },
                "description": "Generates a random code locally AND triggers the Provider API to create a new line/user externally."
              },
              "response": []
            },
            {
              "name": "Display Code (Once)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                      "var jsonData = pm.response.json();",
                      "if(jsonData.data && jsonData.data.code) { console.log(\"RAW CODE REVEALED:\", jsonData.data.code); }"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/admin/code/{{code_id}}/display?token={{display_token}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "admin",
                    "code",
                    "{{code_id}}",
                    "display"
                  ],
                  "query": [
                    {
                      "key": "token",
                      "value": "{{display_token}}"
                    }
                  ]
                },
                "description": "Returns raw code once."
              },
              "response": []
            },
            {
              "name": "Get All Codes",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/admin/codes",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "admin",
                    "codes"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Delete Code",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/admin/code/:id",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "admin",
                    "code",
                    ":id"
                  ],
                  "variable": [
                    {
                      "key": "id",
                      "value": "{{code_id}}"
                    }
                  ]
                },
                "description": "Deletes the code locally AND deletes/bans the user on the Provider Panel."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Monitoring",
